    fn project_local_ray_normal(screen_point: Vec2): Vector3 { return Vector3 { x: 0.0, y: 0.0, z: 0.0 }; }
    fn project_ray_origin(screen_point: Vec2): Vector3 { return Vector3 { x: 0.0, y: 0.0, z: 0.0 }; }
