    fn get_camera_transform(): Transform3D { return Transform3D { basis: Basis { x: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, y: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, z: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }, origin: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn get_camera_projection(): Projection { return Projection { x: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, y: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, z: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, w: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 } }; }
    fn get_fov(): Float { return 0.0; }
    fn get_frustum_offset(): Vec2 { return Vec2 { x: 0.0, y: 0.0 }; }
    fn get_size(): Float { return 0.0; }
    fn get_far(): Float { return 0.0; }
    fn get_near(): Float { return 0.0; }
