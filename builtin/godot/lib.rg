class Rect2 {
    var position: Vec2 = Vec2 { x: 0.0, y: 0.0 };
    var size: Vec2 = Vec2 { x: 0.0, y: 0.0 };
    var end: Vec2 = Vec2 { x: 0.0, y: 0.0 };
    fn get_center(): Vec2 { return Vec2 { x: 0.0, y: 0.0 }; }
    fn get_area(): Float { return 0.0; }
    fn has_area(): Bool { return false; }
    fn has_point(point: Vec2): Bool { return false; }
    fn is_equal_approx(rect: Rect2): Bool { return false; }
    fn is_finite(): Bool { return false; }
    fn intersects(b: Rect2, include_borders: Bool = false): Bool { return false; }
    fn encloses(b: Rect2): Bool { return false; }
    fn intersection(b: Rect2): Rect2 { return Rect2 { position: Vec2 { x: 0.0, y: 0.0 }, size: Vec2 { x: 0.0, y: 0.0 }, end: Vec2 { x: 0.0, y: 0.0 } }; }
    fn merge(b: Rect2): Rect2 { return Rect2 { position: Vec2 { x: 0.0, y: 0.0 }, size: Vec2 { x: 0.0, y: 0.0 }, end: Vec2 { x: 0.0, y: 0.0 } }; }
    fn expand(to: Vec2): Rect2 { return Rect2 { position: Vec2 { x: 0.0, y: 0.0 }, size: Vec2 { x: 0.0, y: 0.0 }, end: Vec2 { x: 0.0, y: 0.0 } }; }
    fn get_support(direction: Vec2): Vec2 { return Vec2 { x: 0.0, y: 0.0 }; }
    fn grow(amount: Float): Rect2 { return Rect2 { position: Vec2 { x: 0.0, y: 0.0 }, size: Vec2 { x: 0.0, y: 0.0 }, end: Vec2 { x: 0.0, y: 0.0 } }; }
    fn grow_side(side: Int, amount: Float): Rect2 { return Rect2 { position: Vec2 { x: 0.0, y: 0.0 }, size: Vec2 { x: 0.0, y: 0.0 }, end: Vec2 { x: 0.0, y: 0.0 } }; }
    fn grow_individual(left: Float, top: Float, right: Float, bottom: Float): Rect2 { return Rect2 { position: Vec2 { x: 0.0, y: 0.0 }, size: Vec2 { x: 0.0, y: 0.0 }, end: Vec2 { x: 0.0, y: 0.0 } }; }
    fn abs(): Rect2 { return Rect2 { position: Vec2 { x: 0.0, y: 0.0 }, size: Vec2 { x: 0.0, y: 0.0 }, end: Vec2 { x: 0.0, y: 0.0 } }; }
}

