class Transform2D {
    var x: Vec2 = Vec2 { x: 0.0, y: 0.0 };
    var y: Vec2 = Vec2 { x: 0.0, y: 0.0 };
    var origin: Vec2 = Vec2 { x: 0.0, y: 0.0 };
    fn inverse(): Transform2D { return Transform2D { x: Vec2 { x: 0.0, y: 0.0 }, y: Vec2 { x: 0.0, y: 0.0 }, origin: Vec2 { x: 0.0, y: 0.0 } }; }
    fn affine_inverse(): Transform2D { return Transform2D { x: Vec2 { x: 0.0, y: 0.0 }, y: Vec2 { x: 0.0, y: 0.0 }, origin: Vec2 { x: 0.0, y: 0.0 } }; }
    fn get_rotation(): Float { return 0.0; }
    fn get_origin(): Vec2 { return Vec2 { x: 0.0, y: 0.0 }; }
    fn get_scale(): Vec2 { return Vec2 { x: 0.0, y: 0.0 }; }
    fn get_skew(): Float { return 0.0; }
    fn orthonormalized(): Transform2D { return Transform2D { x: Vec2 { x: 0.0, y: 0.0 }, y: Vec2 { x: 0.0, y: 0.0 }, origin: Vec2 { x: 0.0, y: 0.0 } }; }
    fn rotated(angle: Float): Transform2D { return Transform2D { x: Vec2 { x: 0.0, y: 0.0 }, y: Vec2 { x: 0.0, y: 0.0 }, origin: Vec2 { x: 0.0, y: 0.0 } }; }
    fn rotated_local(angle: Float): Transform2D { return Transform2D { x: Vec2 { x: 0.0, y: 0.0 }, y: Vec2 { x: 0.0, y: 0.0 }, origin: Vec2 { x: 0.0, y: 0.0 } }; }
    fn scaled(scale: Vec2): Transform2D { return Transform2D { x: Vec2 { x: 0.0, y: 0.0 }, y: Vec2 { x: 0.0, y: 0.0 }, origin: Vec2 { x: 0.0, y: 0.0 } }; }
    fn scaled_local(scale: Vec2): Transform2D { return Transform2D { x: Vec2 { x: 0.0, y: 0.0 }, y: Vec2 { x: 0.0, y: 0.0 }, origin: Vec2 { x: 0.0, y: 0.0 } }; }
    fn translated(offset: Vec2): Transform2D { return Transform2D { x: Vec2 { x: 0.0, y: 0.0 }, y: Vec2 { x: 0.0, y: 0.0 }, origin: Vec2 { x: 0.0, y: 0.0 } }; }
    fn translated_local(offset: Vec2): Transform2D { return Transform2D { x: Vec2 { x: 0.0, y: 0.0 }, y: Vec2 { x: 0.0, y: 0.0 }, origin: Vec2 { x: 0.0, y: 0.0 } }; }
    fn determinant(): Float { return 0.0; }
    fn basis_xform(v: Vec2): Vec2 { return Vec2 { x: 0.0, y: 0.0 }; }
    fn basis_xform_inv(v: Vec2): Vec2 { return Vec2 { x: 0.0, y: 0.0 }; }
    fn interpolate_with(xform: Transform2D, weight: Float): Transform2D { return Transform2D { x: Vec2 { x: 0.0, y: 0.0 }, y: Vec2 { x: 0.0, y: 0.0 }, origin: Vec2 { x: 0.0, y: 0.0 } }; }
    fn is_conformal(): Bool { return false; }
    fn is_equal_approx(xform: Transform2D): Bool { return false; }
    fn is_finite(): Bool { return false; }
    fn looking_at(target: Vec2 = Vec2 { x: 0.0, y: 0.0 }): Transform2D { return Transform2D { x: Vec2 { x: 0.0, y: 0.0 }, y: Vec2 { x: 0.0, y: 0.0 }, origin: Vec2 { x: 0.0, y: 0.0 } }; }
}

