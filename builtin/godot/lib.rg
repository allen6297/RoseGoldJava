    fn set_frustum_offset(offset: Vec2) {}
    fn set_size(size: Float) {}
    fn set_far(far: Float) {}
    fn set_near(near: Float) {}
    fn get_projection(): Int { return 0; }
    fn set_projection(mode: Int) {}
    fn set_h_offset(offset: Float) {}
    fn get_h_offset(): Float { return 0.0; }
    fn set_v_offset(offset: Float) {}
    fn get_v_offset(): Float { return 0.0; }
