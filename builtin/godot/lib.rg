# Generated from Godot extension_api.json.
# Node2D.position, rotation, and scale are copied to and from the live node.
# Array and Dictionary values pass through engine calls as Array and Map.
# Packed arrays pass through as Array[Int], Array[Float], Array[String], Array[Vec2], Array[Vector3], Array[Color], or Array[Vector4].
# RID values pass through as Int. Callable values pass through as functions.
# Signal values pass through as Signal. Variant values pass through as the value they hold.
# Engine singletons such as Input, Time, and Engine are values of those classes.
# Engine methods forward to that node.
# Static methods are called on the class, as in Image.create_empty(...).
# A method ending in ... accepts extra arguments, as in call("set_meta", "n", 7).
# Callable methods such as bind are called on a function, and a Callable from the engine stays a function.
# Value types such as Vec2 and Color keep their engine methods, as in position.lerp(target, 0.5).

singleton Performance;
singleton Engine;
singleton ProjectSettings;
singleton OS;
singleton Time;
singleton ClassDB;
singleton TextServerManager;
singleton NavigationServer2DManager;
singleton PhysicsServer2DManager;
singleton NavigationServer3DManager;
