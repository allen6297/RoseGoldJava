    fn posmod(a0: Float): Vector4 { return Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
    fn posmodv(modv: Vector4): Vector4 { return Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
    fn snapped(step: Vector4): Vector4 { return Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
    fn snappedf(step: Float): Vector4 { return Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
    fn clamp(min: Vector4, max: Vector4): Vector4 { return Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
    fn clampf(min: Float, max: Float): Vector4 { return Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
    fn normalized(): Vector4 { return Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
    fn is_normalized(): Bool { return false; }
    fn direction_to(to: Vector4): Vector4 { return Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
    fn distance_to(to: Vector4): Float { return 0.0; }
    fn distance_squared_to(to: Vector4): Float { return 0.0; }
    fn dot(with: Vector4): Float { return 0.0; }
    fn inverse(): Vector4 { return Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
    fn is_equal_approx(to: Vector4): Bool { return false; }
    fn is_zero_approx(): Bool { return false; }
    fn is_finite(): Bool { return false; }
    fn min(with: Vector4): Vector4 { return Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
    fn minf(with: Float): Vector4 { return Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
    fn max(with: Vector4): Vector4 { return Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
    fn maxf(with: Float): Vector4 { return Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
}

class Vector4i {
    var x: Int = 0;
    var y: Int = 0;
    var z: Int = 0;
    var w: Int = 0;
    fn min_axis_index(): Int { return 0; }
    fn max_axis_index(): Int { return 0; }
    fn length(): Float { return 0.0; }
    fn length_squared(): Int { return 0; }
    fn sign(): Vector4i { return Vector4i { x: 0, y: 0, z: 0, w: 0 }; }
    fn abs(): Vector4i { return Vector4i { x: 0, y: 0, z: 0, w: 0 }; }
    fn clamp(min: Vector4i, max: Vector4i): Vector4i { return Vector4i { x: 0, y: 0, z: 0, w: 0 }; }
    fn clampi(min: Int, max: Int): Vector4i { return Vector4i { x: 0, y: 0, z: 0, w: 0 }; }
    fn snapped(step: Vector4i): Vector4i { return Vector4i { x: 0, y: 0, z: 0, w: 0 }; }
    fn snappedi(step: Int): Vector4i { return Vector4i { x: 0, y: 0, z: 0, w: 0 }; }
    fn min(with: Vector4i): Vector4i { return Vector4i { x: 0, y: 0, z: 0, w: 0 }; }
    fn mini(with: Int): Vector4i { return Vector4i { x: 0, y: 0, z: 0, w: 0 }; }
    fn max(with: Vector4i): Vector4i { return Vector4i { x: 0, y: 0, z: 0, w: 0 }; }
    fn maxi(with: Int): Vector4i { return Vector4i { x: 0, y: 0, z: 0, w: 0 }; }
    fn distance_to(to: Vector4i): Float { return 0.0; }
    fn distance_squared_to(to: Vector4i): Int { return 0; }
}

class Plane {
    var x: Float = 0.0;
    var y: Float = 0.0;
    var z: Float = 0.0;
    var d: Float = 0.0;
    var normal: Vector3 = Vector3 { x: 0.0, y: 0.0, z: 0.0 };
    fn normalized(): Plane { return Plane { x: 0.0, y: 0.0, z: 0.0, d: 0.0, normal: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn get_center(): Vector3 { return Vector3 { x: 0.0, y: 0.0, z: 0.0 }; }
    fn is_equal_approx(to_plane: Plane): Bool { return false; }
    fn is_finite(): Bool { return false; }
    fn is_point_over(point: Vector3): Bool { return false; }
    fn distance_to(point: Vector3): Float { return 0.0; }
    fn has_point(point: Vector3, tolerance: Float = 0.00001): Bool { return false; }
    fn project(point: Vector3): Vector3 { return Vector3 { x: 0.0, y: 0.0, z: 0.0 }; }
    fn intersect_3(b: Plane, c: Plane) {}
    fn intersects_ray(a0: Vector3, dir: Vector3) {}
    fn intersects_segment(a0: Vector3, to: Vector3) {}
}

class Quaternion {
    var x: Float = 0.0;
    var y: Float = 0.0;
    var z: Float = 0.0;
    var w: Float = 0.0;
    fn length(): Float { return 0.0; }
    fn length_squared(): Float { return 0.0; }
    fn normalized(): Quaternion { return Quaternion { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
    fn is_normalized(): Bool { return false; }
    fn is_equal_approx(to: Quaternion): Bool { return false; }
    fn is_finite(): Bool { return false; }
    fn inverse(): Quaternion { return Quaternion { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
    fn log(): Quaternion { return Quaternion { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
    fn exp(): Quaternion { return Quaternion { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
    fn angle_to(to: Quaternion): Float { return 0.0; }
    fn dot(with: Quaternion): Float { return 0.0; }
    fn slerp(to: Quaternion, weight: Float): Quaternion { return Quaternion { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
    fn slerpni(to: Quaternion, weight: Float): Quaternion { return Quaternion { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
    fn spherical_cubic_interpolate(b: Quaternion, pre_a: Quaternion, post_b: Quaternion, weight: Float): Quaternion { return Quaternion { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
    fn spherical_cubic_interpolate_in_time(b: Quaternion, pre_a: Quaternion, post_b: Quaternion, weight: Float, b_t: Float, pre_a_t: Float, post_b_t: Float): Quaternion { return Quaternion { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
    fn get_euler(order: Int = 2): Vector3 { return Vector3 { x: 0.0, y: 0.0, z: 0.0 }; }
    fn get_axis(): Vector3 { return Vector3 { x: 0.0, y: 0.0, z: 0.0 }; }
    fn get_angle(): Float { return 0.0; }
    static fn from_euler(euler: Vector3): Quaternion { return Quaternion { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
}

class AABB {
    var position: Vector3 = Vector3 { x: 0.0, y: 0.0, z: 0.0 };
    var size: Vector3 = Vector3 { x: 0.0, y: 0.0, z: 0.0 };
    var end: Vector3 = Vector3 { x: 0.0, y: 0.0, z: 0.0 };
    fn abs(): AABB { return AABB { position: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, size: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, end: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn get_center(): Vector3 { return Vector3 { x: 0.0, y: 0.0, z: 0.0 }; }
    fn get_volume(): Float { return 0.0; }
    fn has_volume(): Bool { return false; }
    fn has_surface(): Bool { return false; }
    fn has_point(point: Vector3): Bool { return false; }
    fn is_equal_approx(aabb: AABB): Bool { return false; }
    fn is_finite(): Bool { return false; }
    fn intersects(with: AABB): Bool { return false; }
    fn encloses(with: AABB): Bool { return false; }
    fn intersects_plane(plane: Plane): Bool { return false; }
    fn intersection(with: AABB): AABB { return AABB { position: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, size: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, end: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn merge(with: AABB): AABB { return AABB { position: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, size: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, end: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn expand(to_point: Vector3): AABB { return AABB { position: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, size: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, end: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn grow(by: Float): AABB { return AABB { position: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, size: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, end: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn get_support(direction: Vector3): Vector3 { return Vector3 { x: 0.0, y: 0.0, z: 0.0 }; }
    fn get_longest_axis(): Vector3 { return Vector3 { x: 0.0, y: 0.0, z: 0.0 }; }
    fn get_longest_axis_index(): Int { return 0; }
    fn get_longest_axis_size(): Float { return 0.0; }
    fn get_shortest_axis(): Vector3 { return Vector3 { x: 0.0, y: 0.0, z: 0.0 }; }
    fn get_shortest_axis_index(): Int { return 0; }
    fn get_shortest_axis_size(): Float { return 0.0; }
    fn get_endpoint(idx: Int): Vector3 { return Vector3 { x: 0.0, y: 0.0, z: 0.0 }; }
    fn intersects_segment(a0: Vector3, to: Vector3) {}
    fn intersects_ray(a0: Vector3, dir: Vector3) {}
}

class Basis {
    var x: Vector3 = Vector3 { x: 0.0, y: 0.0, z: 0.0 };
    var y: Vector3 = Vector3 { x: 0.0, y: 0.0, z: 0.0 };
    var z: Vector3 = Vector3 { x: 0.0, y: 0.0, z: 0.0 };
    fn inverse(): Basis { return Basis { x: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, y: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, z: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn transposed(): Basis { return Basis { x: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, y: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, z: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn orthonormalized(): Basis { return Basis { x: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, y: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, z: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn determinant(): Float { return 0.0; }
    fn rotated(axis: Vector3, angle: Float): Basis { return Basis { x: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, y: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, z: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn scaled(scale: Vector3): Basis { return Basis { x: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, y: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, z: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn scaled_local(scale: Vector3): Basis { return Basis { x: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, y: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, z: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn get_scale(): Vector3 { return Vector3 { x: 0.0, y: 0.0, z: 0.0 }; }
    fn get_euler(order: Int = 2): Vector3 { return Vector3 { x: 0.0, y: 0.0, z: 0.0 }; }
    fn tdotx(with: Vector3): Float { return 0.0; }
    fn tdoty(with: Vector3): Float { return 0.0; }
    fn tdotz(with: Vector3): Float { return 0.0; }
    fn slerp(to: Basis, weight: Float): Basis { return Basis { x: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, y: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, z: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn is_conformal(): Bool { return false; }
    fn is_equal_approx(b: Basis): Bool { return false; }
    fn is_finite(): Bool { return false; }
    fn is_orthonormal(): Bool { return false; }
    fn get_rotation_quaternion(): Quaternion { return Quaternion { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
    static fn looking_at(target: Vector3, up: Vector3 = Vector3 { x: 0.0, y: 1.0, z: 0.0 }, use_model_front: Bool = false): Basis { return Basis { x: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, y: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, z: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    static fn from_scale(scale: Vector3): Basis { return Basis { x: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, y: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, z: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    static fn from_euler(euler: Vector3, order: Int = 2): Basis { return Basis { x: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, y: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, z: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
}

class Transform3D {
    var basis: Basis = Basis { x: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, y: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, z: Vector3 { x: 0.0, y: 0.0, z: 0.0 } };
    var origin: Vector3 = Vector3 { x: 0.0, y: 0.0, z: 0.0 };
    fn inverse(): Transform3D { return Transform3D { basis: Basis { x: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, y: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, z: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }, origin: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn affine_inverse(): Transform3D { return Transform3D { basis: Basis { x: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, y: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, z: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }, origin: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn orthonormalized(): Transform3D { return Transform3D { basis: Basis { x: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, y: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, z: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }, origin: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn rotated(axis: Vector3, angle: Float): Transform3D { return Transform3D { basis: Basis { x: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, y: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, z: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }, origin: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn rotated_local(axis: Vector3, angle: Float): Transform3D { return Transform3D { basis: Basis { x: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, y: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, z: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }, origin: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn scaled(scale: Vector3): Transform3D { return Transform3D { basis: Basis { x: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, y: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, z: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }, origin: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn scaled_local(scale: Vector3): Transform3D { return Transform3D { basis: Basis { x: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, y: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, z: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }, origin: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn translated(offset: Vector3): Transform3D { return Transform3D { basis: Basis { x: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, y: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, z: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }, origin: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn translated_local(offset: Vector3): Transform3D { return Transform3D { basis: Basis { x: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, y: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, z: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }, origin: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn looking_at(target: Vector3, up: Vector3 = Vector3 { x: 0.0, y: 1.0, z: 0.0 }, use_model_front: Bool = false): Transform3D { return Transform3D { basis: Basis { x: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, y: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, z: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }, origin: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn interpolate_with(xform: Transform3D, weight: Float): Transform3D { return Transform3D { basis: Basis { x: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, y: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, z: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }, origin: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn is_equal_approx(xform: Transform3D): Bool { return false; }
    fn is_finite(): Bool { return false; }
}

class Projection {
    var x: Vector4 = Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 };
    var y: Vector4 = Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 };
    var z: Vector4 = Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 };
    var w: Vector4 = Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 };
    fn determinant(): Float { return 0.0; }
    fn perspective_znear_adjusted(new_znear: Float): Projection { return Projection { x: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, y: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, z: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, w: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 } }; }
    fn get_projection_plane(plane: Int): Plane { return Plane { x: 0.0, y: 0.0, z: 0.0, d: 0.0, normal: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn flipped_y(): Projection { return Projection { x: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, y: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, z: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, w: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 } }; }
    fn jitter_offseted(offset: Vec2): Projection { return Projection { x: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, y: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, z: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, w: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 } }; }
    fn get_z_far(): Float { return 0.0; }
    fn get_z_near(): Float { return 0.0; }
    fn get_aspect(): Float { return 0.0; }
    fn get_fov(): Float { return 0.0; }
    fn is_orthogonal(): Bool { return false; }
    fn get_viewport_half_extents(): Vec2 { return Vec2 { x: 0.0, y: 0.0 }; }
    fn get_far_plane_half_extents(): Vec2 { return Vec2 { x: 0.0, y: 0.0 }; }
    fn inverse(): Projection { return Projection { x: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, y: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, z: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, w: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 } }; }
    fn get_pixels_per_meter(for_pixel_width: Int): Int { return 0; }
    fn get_lod_multiplier(): Float { return 0.0; }
    static fn create_depth_correction(flip_y: Bool): Projection { return Projection { x: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, y: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, z: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, w: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 } }; }
    static fn create_light_atlas_rect(rect: Rect2): Projection { return Projection { x: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, y: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, z: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, w: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 } }; }
    static fn create_perspective(fovy: Float, aspect: Float, z_near: Float, z_far: Float, flip_fov: Bool = false): Projection { return Projection { x: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, y: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, z: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, w: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 } }; }
    static fn create_perspective_hmd(fovy: Float, aspect: Float, z_near: Float, z_far: Float, flip_fov: Bool, eye: Int, intraocular_dist: Float, convergence_dist: Float): Projection { return Projection { x: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, y: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, z: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, w: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 } }; }
    static fn create_for_hmd(eye: Int, aspect: Float, intraocular_dist: Float, display_width: Float, display_to_lens: Float, oversample: Float, z_near: Float, z_far: Float): Projection { return Projection { x: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, y: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, z: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, w: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 } }; }
    static fn create_orthogonal(left: Float, right: Float, bottom: Float, top: Float, z_near: Float, z_far: Float): Projection { return Projection { x: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, y: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, z: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }, w: Vector4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 } }; }
