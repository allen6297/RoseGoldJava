singleton ResourceUID;
singleton WorkerThreadPool;
singleton ThemeDB;
singleton EditorInterface;
singleton GDScriptLanguageProtocol;
singleton JavaClassWrapper;
singleton JavaScriptBridge;
singleton AccessibilityServer;
