singleton NativeMenu;
singleton RenderingServer;
singleton NavigationServer2D;
singleton NavigationServer3D;
singleton PhysicsServer2D;
singleton PhysicsServer3D;
singleton XRServer;

class Signal {
    var name: String = "";
    var object_id: Int = 0;
}

class Fn {
    fn callv(arguments: Array) {}
    fn is_null(): Bool { return false; }
    fn is_custom(): Bool { return false; }
    fn is_standard(): Bool { return false; }
    fn is_valid(): Bool { return false; }
    fn get_object_id(): Int { return 0; }
    fn get_method(): String { return ""; }
    fn get_argument_count(): Int { return 0; }
    fn get_bound_arguments_count(): Int { return 0; }
    fn get_bound_arguments(): Array { return []; }
    fn get_unbound_arguments_count(): Int { return 0; }
    fn hash(): Int { return 0; }
    fn bindv(arguments: Array): Fn { return fn () {}; }
    fn unbind(argcount: Int): Fn { return fn () {}; }
    fn call(...) {}
    fn call_deferred(...) {}
    fn rpc(...) {}
    fn rpc_id(peer_id: Int, ...) {}
    fn bind(...): Fn { return fn () {}; }
    static fn create(variant, method: String): Fn { return fn () {}; }
}

