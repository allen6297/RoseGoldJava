    var interpolate: Bool = false;
    var fract_delta: Bool = false;
    var collision_base_size: Float = 0.0;
    var visibility_aabb: AABB = AABB { position: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, size: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, end: Vector3 { x: 0.0, y: 0.0, z: 0.0 } };
    var local_coords: Bool = false;
    var draw_order: Int = 0;
    var transform_align: Int = 0;
    var transform_align_axis: Int = 0;
    var transform_align_channel_filter: Int = 0;
    var trail_enabled: Bool = false;
    var trail_lifetime: Float = 0.0;
    var draw_passes: Int = 0;
    @optional var draw_pass_1: Mesh;
    @optional var draw_pass_2: Mesh;
    @optional var draw_pass_3: Mesh;
    @optional var draw_pass_4: Mesh;
    @optional var draw_skin: Skin;
    signal finished();
    fn set_emitting(emitting: Bool) {}
    fn set_amount(amount: Int) {}
    fn set_lifetime(secs: Float) {}
    fn set_one_shot(enable: Bool) {}
    fn set_pre_process_time(secs: Float) {}
    fn set_explosiveness_ratio(ratio: Float) {}
    fn set_randomness_ratio(ratio: Float) {}
    fn set_visibility_aabb(aabb: AABB) {}
    fn set_use_local_coordinates(enable: Bool) {}
    fn set_fixed_fps(fps: Int) {}
    fn set_fractional_delta(enable: Bool) {}
    fn set_interpolate(enable: Bool) {}
    fn set_process_material(material: Material) {}
    fn set_speed_scale(scale: Float) {}
    fn set_collision_base_size(size: Float) {}
    fn set_interp_to_end(interp: Float) {}
    fn is_emitting(): Bool { return false; }
    fn get_amount(): Int { return 0; }
    fn get_lifetime(): Float { return 0.0; }
    fn get_one_shot(): Bool { return false; }
    fn get_pre_process_time(): Float { return 0.0; }
    fn get_explosiveness_ratio(): Float { return 0.0; }
    fn get_randomness_ratio(): Float { return 0.0; }
    fn get_visibility_aabb(): AABB { return AABB { position: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, size: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, end: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn get_use_local_coordinates(): Bool { return false; }
    fn get_fixed_fps(): Int { return 0; }
    fn get_fractional_delta(): Bool { return false; }
    fn get_interpolate(): Bool { return false; }
    fn get_process_material(): Material { return Material {}; }
    fn get_speed_scale(): Float { return 0.0; }
    fn get_collision_base_size(): Float { return 0.0; }
    fn get_interp_to_end(): Float { return 0.0; }
    fn set_use_fixed_seed(use_fixed_seed: Bool) {}
    fn get_use_fixed_seed(): Bool { return false; }
    fn set_seed(seed: Int) {}
    fn get_seed(): Int { return 0; }
    fn set_draw_order(order: Int) {}
    fn get_draw_order(): Int { return 0; }
    fn set_draw_passes(passes: Int) {}
    fn set_draw_pass_mesh(a0: Int, mesh: Mesh) {}
    fn get_draw_passes(): Int { return 0; }
    fn get_draw_pass_mesh(a0: Int): Mesh { return Mesh {}; }
    fn set_skin(skin: Skin) {}
    fn get_skin(): Skin { return Skin {}; }
    fn restart(keep_seed: Bool = false) {}
    fn capture_aabb(): AABB { return AABB { position: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, size: Vector3 { x: 0.0, y: 0.0, z: 0.0 }, end: Vector3 { x: 0.0, y: 0.0, z: 0.0 } }; }
    fn set_sub_emitter(path: String) {}
    fn get_sub_emitter(): String { return ""; }
    fn emit_particle(xform: Transform3D, velocity: Vector3, color: Color, custom: Color, flags: Int) {}
    fn set_trail_enabled(enabled: Bool) {}
    fn set_trail_lifetime(secs: Float) {}
    fn is_trail_enabled(): Bool { return false; }
    fn get_trail_lifetime(): Float { return 0.0; }
    fn set_transform_align(align: Int) {}
    fn get_transform_align(): Int { return 0; }
    fn set_transform_align_channel_filter(channel_filter: Int) {}
    fn get_transform_align_channel_filter(): Int { return 0; }
    fn set_transform_align_axis(align: Int) {}
    fn get_transform_align_axis(): Int { return 0; }
    fn convert_from_particles(particles: Node) {}
    fn set_amount_ratio(ratio: Float) {}
    fn get_amount_ratio(): Float { return 0.0; }
    fn request_particles_process(process_time: Float, process_time_residual: Float = 0.0) {}
}

